{
  "manifest_version": 3,
  "name": "Чердак — данные входа для подписки",
  "short_name": "Чердак",
  "version": "1.3.0",
  "description": "Копирует данные входа твоего аккаунта ChatGPT, Claude, Grok, X или Cursor для заказа в Чердаке. Никуда их не отправляет.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Чердак — скопировать данные входа",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["cookies", "activeTab", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://grok.com/*"
  ]
}
